# Copy to secrets.yaml (gitignored) and fill in real values.
#
# No wifi_ssid/wifi_password here: this config has no main wifi: network
# configured, only the ap: fallback hotspot below plus captive_portal:, so
# real credentials are provisioned at runtime through that portal on first
# boot rather than baked into the build.

mqtt_broker: "192.168.1.50"      # the Pi running Mosquitto
mqtt_username: "hottub"
mqtt_password: "changeme"

ota_password: "changeme"
ap_password: "changeme"          # fallback captive-portal hotspot
