// Copy to wifi_credentials.h and fill in. The real file is gitignored.
//
//     cp main/wifi_credentials.h.example main/wifi_credentials.h
//
// Build-time configuration rather than provisioning: this board joins one
// known network and talks to one known broker, so there is nothing to
// configure at runtime and no captive portal to write.
#pragma once

#define WIFI_SSID       "your-ssid"
#define WIFI_PASSWORD   "your-wifi-password"

// The Pi. Needs a stable address -- a DHCP reservation on its *Ethernet*
// MAC, since it is wired to the router.
#define MQTT_BROKER_URI "mqtt://192.168.1.10:1883"
#define MQTT_USERNAME   "hottub"
#define MQTT_PASSWORD   "your-broker-password"
