build
mx.scratch
!.settings

# ESP-IDF generated project config (regenerated from sdkconfig.defaults)
firmware/*/sdkconfig
firmware/*/sdkconfig.old

# Build-time secrets: WiFi and broker credentials. Committed as a
# .example template; the real header is per-machine and never tracked.
wifi_credentials.h

# Dependencies pulled in by the IDF Component Manager. Fetched from
# dependencies.lock at build time, so the tree is reproducible without them.
managed_components/

# Compiled artifacts (in case anything builds outside build/)
*.o
*.d
*.elf
*.bin
*.hex
*.map
*.su

# VS Code editor cruft (keep this if you don't want personal VS Code
# settings committed — skip it if you're intentionally sharing them)
.vscode/ipch/
.vscode/browse.vc.db*
.history/

# OS junk
.DS_Store
Thumbs.db

# KiCad backups, autosaves, and generated caches
*.bak
*.bck
*-backups/
_autosave-*
*-save.pro
*-save.kicad_sch
*-save.kicad_pcb
*.lck
fp-info-cache

# KiCad per-user local project state (like .vscode personal settings above,
# skip this if you're intentionally sharing it)
*.kicad_prl

# draw.io backup files (the desktop app writes these next to the file it's
# editing; the .png patterns cover the editable-PNG diagram in docs/)
*.drawio.bkp
*.drawio.dtmp
*.drawio.png.bkp
*.drawio.png.dtmp
